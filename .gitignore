# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev*.log

# env files (real secrets never committed; the template is safe and needed for onboarding)
.env*
!.env.example

# vercel
.vercel

# local runtime and test artifacts
.stonza/
test-results/
public/uploads/
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# local debug logs, screenshots, and data backups -- not part of the app
.openai/
