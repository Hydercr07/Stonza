NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
OWNER_EMAIL=owner@stonza.local
OWNER_PASSWORD=change-me
# Required in production. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Set to "postgres" only after applying supabase/migrations/202608230001_relational_store.sql
# and running scripts/backfill-postgres.cjs. Unset (or any other value) keeps using the
# legacy JSON-blob store so shipping this code never breaks a deployment ahead of the migration.
DATA_BACKEND=
# Set to "supabase" only after running scripts/bootstrap-supabase-auth.cjs (creates the owner's
# real Supabase Auth account + role). Unset keeps using the signed demo cookie against
# OWNER_EMAIL/OWNER_PASSWORD exactly as before, so shipping this code can't lock anyone out of
# a deployment that hasn't bootstrapped Supabase Auth yet. Needed to add a second admin user later
# -- until then the demo cookie is equally secure for a single owner.
ADMIN_AUTH_BACKEND=
NEXT_PUBLIC_WHATSAPP_NUMBER=+923058599096
# Optional: order confirmation + owner-notification emails via Resend (resend.com).
# Unset means emails are silently skipped -- checkout works fine without them.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend. Defaults to orders@<your-site-domain>.
ORDER_EMAIL_FROM=
# Optional: error monitoring via Sentry (sentry.io). Unset means errors are only
# visible in server logs -- the app behaves identically either way.
SENTRY_DSN=
# Same DSN, but exposed to the browser bundle for client-side error capture.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only: lets Sentry upload readable source maps instead of
# minified ones. From Sentry -> Settings -> Auth Tokens (needs project:releases scope).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
